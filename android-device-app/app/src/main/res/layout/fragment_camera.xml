<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity">

    <TextureView
        android:id="@+id/surface"
        android:layout_centerInParent="true"
        android:layout_width="400dp"
        android:layout_height="500dp"
        />

    <com.qc.posedetectionYoloNAS.FragmentRender
        android:id="@+id/fragmentRender"
        android:layout_centerInParent="true"
        android:layout_width="400dp"
        android:layout_height="500dp"
        />

    <!-- voice-coach toggle: bottom-left circle. Declared AFTER fragmentRender so it draws on top and,
         being clickable with its own listener, consumes its own tap (the overlay rotates on the rest). -->
    <ImageView
        android:id="@+id/voice_toggle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="24dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/voice_toggle_desc"
        android:background="@drawable/voice_btn_bg"
        android:src="@drawable/ic_voice_on" />
</RelativeLayout>