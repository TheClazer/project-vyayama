<resources>

    <!-- Vyāyāma · Volt — premium dark theme with an electric-lime accent. -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/volt</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="actionBarStyle">@style/Volt.ActionBar</item>
        <item name="actionBarPopupTheme">@style/AppTheme.PopupOverlay</item>
    </style>

    <style name="Volt.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/surface</item>
        <item name="titleTextStyle">@style/Volt.Title</item>
        <item name="subtitleTextStyle">@style/Volt.Subtitle</item>
    </style>

    <style name="Volt.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/volt</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Volt.Subtitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/textMuted</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <!-- Splash / launch-screen themes (Theme.Vyayama.Splash is used by SplashActivity) -->
    <style name="Theme.Vyayama" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="colorPrimary">@color/volt</item>
        <item name="colorAccent">@color/volt</item>
    </style>
    <style name="Theme.Vyayama.Splash" parent="Theme.Vyayama">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

</resources>
