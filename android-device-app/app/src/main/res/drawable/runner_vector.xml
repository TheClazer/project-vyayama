<?xml version="1.0" encoding="utf-8"?>
<!--
  Vyāyāma running athlete — 108x108 viewport.
  Limbs are split into named <group>s with pivots at the shoulder (57,47)
  and hip (52,64) so the AnimatedVectorDrawable can swing them.
  Doubles as the adaptive-icon foreground (volt figure on ink).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- speed streaks (behind everything) -->
    <group android:name="streaks">
        <path
            android:name="streak_top"
            android:pathData="M24,50 L37,50"
            android:strokeColor="#9FD42A"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
        <path
            android:name="streak_bottom"
            android:pathData="M21,63 L35,63"
            android:strokeColor="#9FD42A"
            android:strokeWidth="5"
            android:strokeLineCap="round" />
    </group>

    <!-- back limbs (drawn first so they sit behind the torso) -->
    <group android:name="backArm" android:pivotX="57" android:pivotY="47">
        <path
            android:pathData="M57,47 L74,40"
            android:strokeColor="#C8FF3C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <group android:name="backLeg" android:pivotX="52" android:pivotY="64">
        <path
            android:pathData="M52,64 L40,79"
            android:strokeColor="#C8FF3C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <!-- torso -->
    <path
        android:pathData="M61,40 L52,64"
        android:strokeColor="#C8FF3C"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- front limbs -->
    <group android:name="frontArm" android:pivotX="57" android:pivotY="47">
        <path
            android:pathData="M57,47 L43,55"
            android:strokeColor="#C8FF3C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <group android:name="frontLeg" android:pivotX="52" android:pivotY="64">
        <path
            android:pathData="M52,64 L64,74 L61,87"
            android:strokeColor="#C8FF3C"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>

    <!-- head -->
    <path
        android:name="head"
        android:pathData="M61,32 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#C8FF3C" />

</vector>
